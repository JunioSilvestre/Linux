# EditorConfig — https://editorconfig.org
# Linux Systems Engineering Repository

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.sh]
indent_size = 2
indent_style = space

[*.py]
indent_size = 4
indent_style = space

[Makefile]
indent_style = tab
indent_size = 4

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.json]
indent_size = 2
